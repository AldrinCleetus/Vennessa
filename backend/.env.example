# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=boreal-union-515307-d9
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash

# Optional fallback when Vertex AI credentials (ADC) are unavailable.
# Use a Gemini API key from Google AI Studio. If unset, Vertex AI is the only provider.
GEMINI_API_KEY=
# Only needed if the Gemini API uses a different model name than GEMINI_MODEL.
GEMINI_API_MODEL=gemini-3.5-flash
# Set to true to use the API key first instead of Vertex AI.
GEMINI_PREFER_API_KEY=false
# If every Gemini provider fails, AI endpoints return a deterministic local
# fallback and include a warning in the response so the workflow stays usable.

# Server Configuration
PORT=8080
ENVIRONMENT=development
# Comma-separated or JSON array. For Render, add the exact frontend origin,
# e.g. ["https://vennessa-web.onrender.com"]. Use * only for public prototypes.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# Leave false unless the browser needs cookies/auth headers cross-origin.
CORS_ALLOW_CREDENTIALS=false
